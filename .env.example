# LLM Configuration
# Model requested: openai's gpt-6-luna with xhigh thinking mode
LLM_MODEL=gpt-6-luna
LLM_THINKING_MODE=xhigh

# OpenAI API Key (Optional - tool includes high-fidelity adaptive fallback engine)
OPENAI_API_KEY=

# Server Settings
HOST=127.0.0.1
PORT=8000

# Probing & Safety Settings
SAFE_ACTIVE_MODE=true
MAX_PROBE_CONCURRENCY=5
REQUEST_TIMEOUT_SECONDS=8.0
